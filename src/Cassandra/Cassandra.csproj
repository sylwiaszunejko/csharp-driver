<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>A modern, feature-rich and highly tunable C# client library for ScyllaDB and Apache Cassandra</Description>
    <Copyright>Copyright © by DataStax and ScyllaDB</Copyright>
    <AssemblyTitle>ScyllaDB C# Driver for ScyllaDB</AssemblyTitle>
    <AssemblyVersion>4.99.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>DataStax and ScyllaDB</Authors>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>ScyllaDB</AssemblyName>
    <Product>ScyllaDB C# Driver for Scylla</Product>
    <AssemblyOriginatorKeyFile>../../build/scylladb.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PackageId>ScyllaDBCSharpDriver</PackageId>
    <Version>4.0.0.0</Version>
    <Title>ScyllaDB C# Driver</Title>
    <PackageTags>driver;client;database;nosql;dotnet;netcore;db;scylla;scylladb</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <RepositoryUrl>https://github.com/scylladb/csharp-driver</RepositoryUrl>
    <PackageProjectUrl>https://github.com/scylladb/csharp-driver</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="LICENSE.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tracks the shipped public API surface; see "Public API changes" in CONTRIBUTING.md. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Keep the API-tracking rules (RS0016/RS0017/RS0036/RS0037) but not the package's overload-design
         rules: RS0022/RS0026/RS0027 flag existing public overloads that cannot change without breaking callers. -->
    <NoWarn>$(NoWarn);RS0022;RS0026;RS0027</NoWarn>
  </PropertyGroup>

</Project>
